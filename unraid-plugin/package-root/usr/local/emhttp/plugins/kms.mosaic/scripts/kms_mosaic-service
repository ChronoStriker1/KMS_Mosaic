#!/bin/bash
set -euo pipefail

PLUGIN="kms.mosaic"
CFG="${KMS_MOSAIC_CFG:-/boot/config/plugins/${PLUGIN}/${PLUGIN}.cfg}"
KMS_PIDFILE="${KMS_PIDFILE:-/var/run/kms_mosaic.pid}"
WEB_PIDFILE="${WEB_PIDFILE:-/var/run/kms_mosaic_web.pid}"
KMS_SUPERVISOR_PIDFILE="${KMS_SUPERVISOR_PIDFILE:-/var/run/kms_mosaic_supervisor.pid}"
WEB_SUPERVISOR_PIDFILE="${WEB_SUPERVISOR_PIDFILE:-/var/run/kms_mosaic_web_supervisor.pid}"
KMS_STOP_FILE="${KMS_STOP_FILE:-/var/run/kms_mosaic.stop}"
WEB_STOP_FILE="${WEB_STOP_FILE:-/var/run/kms_mosaic_web.stop}"
KMS_LOG="${KMS_LOG:-/tmp/start_kms_mosaic.log}"
WEB_LOG="${WEB_LOG:-/tmp/kms_mosaic_web.log}"
LIFECYCLE_LOG="${LIFECYCLE_LOG:-/boot/config/plugins/${PLUGIN}/lifecycle.log}"
LOG_MAX_BYTES="${LOG_MAX_BYTES:-1048576}"
LIFECYCLE_MAX_BYTES="${LIFECYCLE_MAX_BYTES:-65536}"
RESTART_DELAY="${RESTART_DELAY:-5}"
SUPERVISOR_POLL_INTERVAL="${SUPERVISOR_POLL_INTERVAL:-1}"
STARTUP_DEP_TIMEOUT="${STARTUP_DEP_TIMEOUT:-30}"
STARTUP_HEALTH_TIMEOUT="${STARTUP_HEALTH_TIMEOUT:-30}"

SERVICE="enable"
WEB_SERVICE="enable"
WEB_PORT="8788"
WEB_HOST="127.0.0.1"
CONFIG_PATH="/boot/config/kms_mosaic.conf"
LOG_ENABLE="disable"
KMS_ARGS="--atomic-nonblock"
DDC_STARTUP="enable"
DDC_CONNECTOR=""
DDC_BUS=""
DDC_INPUT_CODE="20"
DDC_INPUT_VALUE="6"
DDC_BRIGHTNESS="100"
DDC_CONTRAST="100"
DDC_SAVE="enable"

[ -r "$CFG" ] && source "$CFG"

SELF="${BASH_SOURCE[0]}"
KMS_WRAPPER="${KMS_WRAPPER:-/usr/local/bin/kms_mosaic}"
WEB_WRAPPER="${WEB_WRAPPER:-/usr/local/bin/kms_mosaic_web}"
KMS_LIBDIR="${KMS_LIBDIR:-/usr/local/lib/kms_mosaic}"
SNAPSHOT_REQUEST="${SNAPSHOT_REQUEST:-/tmp/kms_mosaic_snapshot.request}"
SNAPSHOT_OUTPUT="${SNAPSHOT_OUTPUT:-/tmp/kms_mosaic_preview.rgba}"

trim_file() {
  local file="$1"
  local max_bytes="$2"
  [ -f "$file" ] || return 0
  local size
  size="$(stat -c '%s' "$file" 2>/dev/null || printf '0')"
  [ "$size" -le "$max_bytes" ] && return 0
  local keep_bytes=$((max_bytes / 2))
  local tmp="${file}.trim.$$"
  tail -c "$keep_bytes" "$file" > "$tmp" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null || true
    return 0
  }
  mv -f "$tmp" "$file"
}

lifecycle_event() {
  local service="$1"
  local event="$2"
  local pid="${3:-}"
  local detail="${4:-}"
  mkdir -p "$(dirname "$LIFECYCLE_LOG")" 2>/dev/null || true
  printf '%s service=%s event=%s pid=%s %s\n' \
    "$(date -Is)" "$service" "$event" "${pid:--}" "$detail" >> "$LIFECYCLE_LOG" 2>/dev/null || true
  trim_file "$LIFECYCLE_LOG" "$LIFECYCLE_MAX_BYTES"
}

pid_is_running() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  local state
  state="$(ps -o stat= -p "$pid" 2>/dev/null | awk 'NR == 1 {print $1}')"
  [ -n "$state" ] && [[ "$state" != Z* ]]
}

pidfile_process_running() {
  local file="$1"
  local expected_arg="$2"
  [ -r "$file" ] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  pid_is_running "$pid" || return 1
  [ -r "/proc/${pid}/cmdline" ] || return 1
  tr '\0' ' ' < "/proc/${pid}/cmdline" | grep -F -- "$expected_arg" >/dev/null 2>&1
}

is_kms_supervisor_running() {
  pidfile_process_running "$KMS_SUPERVISOR_PIDFILE" "supervise-kms"
}

is_web_supervisor_running() {
  pidfile_process_running "$WEB_SUPERVISOR_PIDFILE" "supervise-web"
}

logging_enabled() {
  case "${LOG_ENABLE:-disable}" in
    enable|enabled|1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

kms_log_target() {
  touch "$KMS_LOG" 2>/dev/null || true
  trim_file "$KMS_LOG" "$LOG_MAX_BYTES"
  printf '%s' "$KMS_LOG"
}

web_log_target() {
  touch "$WEB_LOG" 2>/dev/null || true
  trim_file "$WEB_LOG" "$LOG_MAX_BYTES"
  printf '%s' "$WEB_LOG"
}

kms_extra_args() {
  local args="${KMS_ARGS:-}"
  if logging_enabled; then
    args="${args:+${args} }--debug"
  fi
  printf '%s' "$args"
  return 0
}

web_extra_args() {
  if logging_enabled; then
    printf '%s' "--verbose"
  fi
  return 0
}

cleanup_host_gpu_libs() {
  rm -f "$KMS_LIBDIR"/libdrm*.so* \
        "$KMS_LIBDIR"/libgbm.so* \
        "$KMS_LIBDIR"/libEGL*.so* \
        "$KMS_LIBDIR"/libGLESv2.so* \
        "$KMS_LIBDIR"/libGL*.so* \
        "$KMS_LIBDIR"/libOpenGL.so* \
        "$KMS_LIBDIR"/libgallium*.so* \
        "$KMS_LIBDIR"/libX11*.so* \
        "$KMS_LIBDIR"/libXau.so* \
        "$KMS_LIBDIR"/libXdmcp.so* \
        "$KMS_LIBDIR"/libXext.so* \
        "$KMS_LIBDIR"/libxcb*.so* \
        "$KMS_LIBDIR"/libwayland*.so* \
        "$KMS_LIBDIR"/libxshmfence.so* \
        "$KMS_LIBDIR"/libpciaccess.so* \
        "$KMS_LIBDIR"/libLLVM*.so* \
        "$KMS_LIBDIR"/libSPIRV*.so* \
        "$KMS_LIBDIR"/libsensors.so* \
        "$KMS_LIBDIR"/libelf.so* \
        "$KMS_LIBDIR"/libedit.so* \
        "$KMS_LIBDIR"/libexpat.so* \
        "$KMS_LIBDIR"/libz.so* \
        "$KMS_LIBDIR"/libzstd.so* \
        "$KMS_LIBDIR"/liblzma.so* \
        "$KMS_LIBDIR"/libbz2.so* \
        "$KMS_LIBDIR"/libffi.so* \
        "$KMS_LIBDIR"/libncursesw.so* \
        "$KMS_LIBDIR"/libtinfo.so* 2>/dev/null || true
}

wait_for_runtime_dependencies() {
  local waited=0
  while [ "$waited" -lt "$STARTUP_DEP_TIMEOUT" ]; do
    if compgen -G '/dev/dri/card*' >/dev/null &&
       [ -r /usr/lib64/libdrm.so.2 ] &&
       [ -r /usr/lib64/libgbm.so.1 ] &&
       [ -r /usr/lib64/libEGL.so.1 ] &&
       [ -r /usr/lib64/libGLESv2.so.2 ] &&
       [ -d /usr/lib64/dri ]; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

request_fresh_render() {
  local waited=0
  rm -f "$SNAPSHOT_OUTPUT" 2>/dev/null || true
  touch "$SNAPSHOT_REQUEST"
  while [ "$waited" -lt "$STARTUP_HEALTH_TIMEOUT" ]; do
    is_kms_running || return 1
    if [ -s "$SNAPSHOT_OUTPUT" ]; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

kms_render_healthy() {
  request_fresh_render || return 1
  sleep 2
  request_fresh_render || return 1
  rm -f "$SNAPSHOT_REQUEST" "$SNAPSHOT_OUTPUT" 2>/dev/null || true
  return 0
}

launch_detached() {
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid "$@" &
  else
    nohup "$@" &
  fi
}

supervise_kms() {
  local stopping=0
  trap 'stopping=1' TERM INT HUP
  lifecycle_event "kms" "supervisor-started" "$$"
  while [ "$stopping" -eq 0 ] && [ ! -e "$KMS_STOP_FILE" ]; do
    local target
    target="$(kms_log_target)"
    local extra
    extra="$(kms_extra_args)"
    if [ -n "$extra" ]; then
      "$KMS_WRAPPER" --config "$CONFIG_PATH" $extra >>"$target" 2>&1 &
    else
      "$KMS_WRAPPER" --config "$CONFIG_PATH" >>"$target" 2>&1 &
    fi
    local child=$!
    write_pidfile "$KMS_PIDFILE" "$child"
    lifecycle_event "kms" "process-started" "$child"

    local child_groups=""
    while [ "$stopping" -eq 0 ] && [ ! -e "$KMS_STOP_FILE" ] && pid_is_running "$child"; do
      local new_groups
      new_groups="$(kms_child_group_leaders "$child" || true)"
      if [ -n "$new_groups" ]; then
        child_groups="$(printf '%s\n%s\n' "$child_groups" "$new_groups" | awk 'NF && !seen[$0]++')"
      fi
      sleep "$SUPERVISOR_POLL_INTERVAL"
      trim_file "$target" "$LOG_MAX_BYTES"
    done
    if [ "$stopping" -ne 0 ] || [ -e "$KMS_STOP_FILE" ]; then
      lifecycle_event "kms" "supervisor-stopping" "$$" "child=${child}"
      return 0
    fi

    local rc=0
    set +e
    wait "$child"
    rc=$?
    set -e
    local group
    for group in $child_groups; do
      kill_process_group "$group"
    done
    cleanup_pidfile_if_matches "$KMS_PIDFILE" "$child"
    trim_file "$target" "$LOG_MAX_BYTES"
    lifecycle_event "kms" "unexpected-exit" "$child" \
      "rc=${rc} cleaned_groups=$(printf '%s\n' "$child_groups" | awk 'NF {count++} END {print count + 0}') restart_in=${RESTART_DELAY}s"
    sleep "$RESTART_DELAY"
  done
  lifecycle_event "kms" "supervisor-stopped" "$$"
}

supervise_web() {
  local stopping=0
  trap 'stopping=1' TERM INT HUP
  lifecycle_event "web" "supervisor-started" "$$"
  while [ "$stopping" -eq 0 ] && [ ! -e "$WEB_STOP_FILE" ]; do
    local target
    target="$(web_log_target)"
    local extra
    extra="$(web_extra_args)"
    if [ -n "$extra" ]; then
      "$WEB_WRAPPER" --config "$CONFIG_PATH" --host "$WEB_HOST" --port "$WEB_PORT" $extra >>"$target" 2>&1 &
    else
      "$WEB_WRAPPER" --config "$CONFIG_PATH" --host "$WEB_HOST" --port "$WEB_PORT" >>"$target" 2>&1 &
    fi
    local child=$!
    write_pidfile "$WEB_PIDFILE" "$child"
    lifecycle_event "web" "process-started" "$child"

    while [ "$stopping" -eq 0 ] && [ ! -e "$WEB_STOP_FILE" ] && pid_is_running "$child"; do
      sleep "$SUPERVISOR_POLL_INTERVAL"
      trim_file "$target" "$LOG_MAX_BYTES"
    done
    if [ "$stopping" -ne 0 ] || [ -e "$WEB_STOP_FILE" ]; then
      lifecycle_event "web" "supervisor-stopping" "$$" "child=${child}"
      return 0
    fi

    local rc=0
    set +e
    wait "$child"
    rc=$?
    set -e
    cleanup_pidfile_if_matches "$WEB_PIDFILE" "$child"
    trim_file "$target" "$LOG_MAX_BYTES"
    lifecycle_event "web" "unexpected-exit" "$child" "rc=${rc} restart_in=${RESTART_DELAY}s"
    sleep "$RESTART_DELAY"
  done
  lifecycle_event "web" "supervisor-stopped" "$$"
}

stop_supervisor() {
  local pidfile="$1"
  local expected_arg="$2"
  if pidfile_process_running "$pidfile" "$expected_arg"; then
    local pid
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    local waited=0
    while [ "$waited" -lt 10 ] && pid_is_running "$pid"; do
      sleep 1
      waited=$((waited + 1))
    done
    kill -9 "$pid" 2>/dev/null || true
  fi
  cleanup_pidfile "$pidfile"
}

web_pid_from_system() {
  pgrep -fo "/usr/local/bin/kms_mosaic_web.py --config ${CONFIG_PATH} --host ${WEB_HOST} --port ${WEB_PORT}" 2>/dev/null || true
}

is_kms_running() {
  local pid
  for pid in $(pgrep -x kms_mosaic.bin 2>/dev/null || true); do
    pid_is_running "$pid" && return 0
  done
  return 1
}

kms_pid_from_system() {
  local pid
  for pid in $(pgrep -x kms_mosaic.bin 2>/dev/null || true); do
    if pid_is_running "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
  done
  return 0
}

kms_pids_from_system() {
  local pid
  for pid in $(pgrep -x kms_mosaic.bin 2>/dev/null || true); do
    pid_is_running "$pid" && printf '%s\n' "$pid"
  done
  return 0
}

wait_for_kms_exit() {
  local max_wait="${1:-20}"
  local waited=0
  while [ "$waited" -lt "$max_wait" ]; do
    if ! is_kms_running; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

kms_child_group_leaders() {
  local pid="$1"
  [ -n "$pid" ] || return 0
  ps -o pid=,pgid= --ppid "$pid" 2>/dev/null | awk '
    NF >= 2 {
      pid = $1
      pgid = $2
      if (pgid == "" || pgid == "0") pgid = pid
      if (!seen[pgid]++) print pgid
    }
  '
}

kill_process_group() {
  local leader="$1"
  [ -n "$leader" ] || return 0
  kill -- "-${leader}" 2>/dev/null || true
  kill "$leader" 2>/dev/null || true
  sleep 1
  kill -9 -- "-${leader}" 2>/dev/null || true
  kill -9 "$leader" 2>/dev/null || true
}

is_web_running() {
  local pid=""
  if [ -f "$WEB_PIDFILE" ]; then
    pid="$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
  fi
  if pid_is_running "$pid"; then
    return 0
  fi
  pid="$(web_pid_from_system)"
  [ -n "$pid" ] || return 1
  write_pidfile "$WEB_PIDFILE" "$pid"
  pid_is_running "$pid"
}

write_pidfile() {
  local file="$1"
  local pid="$2"
  printf '%s\n' "$pid" > "$file"
}

cleanup_pidfile() {
  local file="$1"
  rm -f "$file" 2>/dev/null || true
}

cleanup_pidfile_if_matches() {
  local file="$1"
  local expected="$2"
  local current=""
  current="$(cat "$file" 2>/dev/null || true)"
  [ "$current" = "$expected" ] && cleanup_pidfile "$file"
  return 0
}

post_start_ddc() {
  case "${DDC_STARTUP:-disable}" in
    enable|enabled|1|true|yes|on) ;;
    *) return 0 ;;
  esac
(
  sleep 5
  DDC_CONNECTOR="${DDC_CONNECTOR:-}" DDC_BUS="${DDC_BUS:-}" \
  DDC_INPUT_CODE="${DDC_INPUT_CODE:-20}" DDC_INPUT_VALUE="${DDC_INPUT_VALUE:-6}" \
  DDC_BRIGHTNESS="${DDC_BRIGHTNESS:-100}" DDC_CONTRAST="${DDC_CONTRAST:-100}" \
  DDC_SAVE="${DDC_SAVE:-enable}" CONFIG_PATH="$CONFIG_PATH" python3 - <<'PY'
import fcntl
import os
from pathlib import Path
import shlex
import time

I2C_SLAVE_FORCE = 0x0706
ADDR = 0x37

def enabled(value):
    return str(value).lower() in {"enable", "enabled", "1", "true", "yes", "on"}

def number(name, default):
    try:
        return max(0, min(int(os.environ.get(name, default), 0), 255))
    except ValueError:
        return default

def configured_connector():
    explicit = os.environ.get("DDC_CONNECTOR", "").strip()
    if explicit:
        return explicit
    try:
        tokens = shlex.split(Path(os.environ["CONFIG_PATH"]).read_text())
    except (OSError, ValueError, KeyError):
        return ""
    for index, token in enumerate(tokens[:-1]):
        if token == "--connector":
            return tokens[index + 1]
    return ""

def bus_for_connector(connector):
    explicit = os.environ.get("DDC_BUS", "").strip()
    if explicit:
        return explicit if Path(explicit).exists() else ""
    candidates = []
    for drm_path in sorted(Path("/sys/class/drm").glob("card*-*")):
        status = drm_path / "status"
        try:
            if status.read_text().strip() != "connected":
                continue
        except OSError:
            continue
        name = drm_path.name.split("-", 1)[-1]
        if connector and connector not in {name, drm_path.name}:
            continue
        if not connector:
            try:
                if (drm_path / "enabled").read_text().strip() != "enabled":
                    continue
            except OSError:
                pass
        for match in list((drm_path / "ddc/i2c-dev").glob("i2c-*")) + list((drm_path / "device").glob("i2c-*")):
            device = Path("/dev") / match.name
            if device.exists():
                candidates.append(str(device))
        ddc = drm_path / "ddc"
        try:
            resolved = ddc.resolve(strict=True)
            if resolved.name.startswith("i2c-") and (Path("/dev") / resolved.name).exists():
                candidates.append(str(Path("/dev") / resolved.name))
        except OSError:
            pass
    unique = list(dict.fromkeys(candidates))
    return unique[0] if len(unique) == 1 else ""

BUS = bus_for_connector(configured_connector())
if not BUS:
    raise SystemExit(0)

def checksum(payload):
    value = 0x6E
    for byte in payload:
        value ^= byte
    return value

def send(payload):
    message = bytes(payload + [checksum(payload)])
    fd = os.open(BUS, os.O_RDWR)
    try:
        fcntl.ioctl(fd, I2C_SLAVE_FORCE, ADDR)
        os.write(fd, message)
    finally:
        os.close(fd)

payloads = [
    [0x51, 0x84, 0x03, number("DDC_INPUT_CODE", 0x14), 0x00, number("DDC_INPUT_VALUE", 6)],
    [0x51, 0x84, 0x03, 0x10, 0x00, number("DDC_BRIGHTNESS", 100)],
    [0x51, 0x84, 0x03, 0x12, 0x00, number("DDC_CONTRAST", 100)],
]
if enabled(os.environ.get("DDC_SAVE", "enable")):
    payloads.append([0x51, 0x81, 0x0C])
for payload in payloads:
    send(payload)
    time.sleep(0.2)
PY
) >/dev/null 2>&1 &
}

start_kms() {
  [ "${SERVICE}" = "enable" ] || return 0
  if is_kms_running && is_kms_supervisor_running; then
    return 0
  fi
  if is_kms_running || is_kms_supervisor_running; then
    lifecycle_event "kms" "replacing-unmanaged-or-partial-start" "$$"
    stop_kms
  fi
  if ! wait_for_runtime_dependencies; then
    lifecycle_event "kms" "dependency-timeout" "$$"
    return 1
  fi
  local attempt
  for attempt in 1 2; do
    cleanup_host_gpu_libs
    rm -f "$KMS_STOP_FILE" 2>/dev/null || true
    launch_detached "$SELF" supervise-kms >/dev/null 2>&1
    write_pidfile "$KMS_SUPERVISOR_PIDFILE" "$!"
    local waited=0
    while [ "$waited" -lt 5 ] && ! is_kms_running; do
      sleep 1
      waited=$((waited + 1))
    done
    if is_kms_running && kms_render_healthy; then
      lifecycle_event "kms" "startup-healthy" "$(kms_pid_from_system)" "attempt=${attempt}"
      post_start_ddc
      return 0
    fi
    lifecycle_event "kms" "startup-unhealthy" "$(kms_pid_from_system)" "attempt=${attempt}"
    stop_kms
    sleep 5
  done
  return 1
}

stop_kms() {
  local pids=""
  local pid=""
  local child_groups=""
  touch "$KMS_STOP_FILE"
  stop_supervisor "$KMS_SUPERVISOR_PIDFILE" "supervise-kms"
  pids="$(kms_pids_from_system)"
  if [ -n "$pids" ]; then
    for pid in $pids; do
      local new_groups=""
      new_groups="$(kms_child_group_leaders "$pid" || true)"
      if [ -n "$new_groups" ]; then
        child_groups="$(printf '%s\n%s\n' "$child_groups" "$new_groups" | awk 'NF && !seen[$0]++')"
      fi
      kill "$pid" 2>/dev/null || true
    done
    for _ in 1 2 3 4 5; do
      local any_running="false"
      for pid in $pids; do
        local new_groups=""
        new_groups="$(kms_child_group_leaders "$pid" || true)"
        if [ -n "$new_groups" ]; then
          child_groups="$(printf '%s\n%s\n' "$child_groups" "$new_groups" | awk 'NF && !seen[$0]++')"
        fi
        if pid_is_running "$pid"; then
          any_running="true"
        fi
      done
      if [ "$any_running" = "false" ]; then
        break
      fi
      sleep 1
    done
    for pid in $pids; do
      if pid_is_running "$pid"; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    done
    wait_for_kms_exit 20 || true
    for leader in $child_groups; do
      kill_process_group "$leader"
    done
  fi
  cleanup_pidfile "$KMS_PIDFILE"
  lifecycle_event "kms" "stopped" "$$"
}

start_web() {
  [ "${WEB_SERVICE}" = "enable" ] || return 0
  if is_web_running && is_web_supervisor_running; then
    return 0
  fi
  if is_web_running || is_web_supervisor_running; then
    lifecycle_event "web" "replacing-unmanaged-or-partial-start" "$$"
    stop_web
  fi
  rm -f "$WEB_STOP_FILE" 2>/dev/null || true
  launch_detached "$SELF" supervise-web >/dev/null 2>&1
  write_pidfile "$WEB_SUPERVISOR_PIDFILE" "$!"
  local waited=0
  while [ "$waited" -lt 10 ]; do
    if is_web_running &&
       curl -fsS --max-time 2 "http://${WEB_HOST}:${WEB_PORT}/api/health" >/dev/null 2>&1; then
      lifecycle_event "web" "startup-healthy" "$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  lifecycle_event "web" "startup-unhealthy" "$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
  return 1
}

stop_web() {
  local pid=""
  touch "$WEB_STOP_FILE"
  stop_supervisor "$WEB_SUPERVISOR_PIDFILE" "supervise-web"
  if is_web_running; then
    pid="$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    sleep 2
  fi
  pid="$(web_pid_from_system)"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  cleanup_pidfile "$WEB_PIDFILE"
  lifecycle_event "web" "stopped" "$$"
}

status_json() {
  local kms_pid=""
  local web_pid=""
  local kms_running="false"
  local web_running="false"
  local kms_supervisor_running="false"
  local web_supervisor_running="false"
  if is_kms_running; then
    kms_pid="$(pgrep -x kms_mosaic.bin | head -n1)"
    kms_running="true"
  fi
  if is_web_running; then
    web_pid="$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
    web_running="true"
  fi
  is_kms_supervisor_running && kms_supervisor_running="true"
  is_web_supervisor_running && web_supervisor_running="true"
  cat <<EOF
{"service":"${SERVICE}","web_service":"${WEB_SERVICE}","web_port":"${WEB_PORT}","config_path":"${CONFIG_PATH}","log_enable":"${LOG_ENABLE}","kms_args":"${KMS_ARGS}","kms_running":${kms_running},"web_running":${web_running},"kms_supervisor_running":${kms_supervisor_running},"web_supervisor_running":${web_supervisor_running},"kms_pid":"${kms_pid}","web_pid":"${web_pid}","lifecycle_log":"${LIFECYCLE_LOG}"}
EOF
}

cmd="${1:-status}"
case "$cmd" in
  start)
    start_kms || true
    start_web || true
    ;;
  stop)
    stop_web
    stop_kms
    ;;
  restart)
    stop_web
    stop_kms
    wait_for_kms_exit 20 || true
    start_kms || true
    start_web || true
    ;;
  status)
    status_json
    ;;
  supervise-kms)
    supervise_kms
    ;;
  supervise-web)
    supervise_web
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
