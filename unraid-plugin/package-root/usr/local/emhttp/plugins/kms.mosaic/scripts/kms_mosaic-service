#!/bin/bash
set -euo pipefail

PLUGIN="kms.mosaic"
CFG="/boot/config/plugins/${PLUGIN}/${PLUGIN}.cfg"
KMS_PIDFILE="/var/run/kms_mosaic.pid"
WEB_PIDFILE="/var/run/kms_mosaic_web.pid"
KMS_LOG="/tmp/start_kms_mosaic.log"
WEB_LOG="/tmp/kms_mosaic_web.log"
LOG_MAX_BYTES="${LOG_MAX_BYTES:-1048576}"
STARTUP_DEP_TIMEOUT="${STARTUP_DEP_TIMEOUT:-30}"
STARTUP_HEALTH_TIMEOUT="${STARTUP_HEALTH_TIMEOUT:-15}"

SERVICE="enable"
WEB_SERVICE="enable"
WEB_PORT="8788"
WEB_HOST="127.0.0.1"
CONFIG_PATH="/boot/config/kms_mosaic.conf"
LOG_ENABLE="disable"
KMS_ARGS="--atomic-nonblock"

[ -r "$CFG" ] && source "$CFG"

KMS_WRAPPER="/usr/local/bin/kms_mosaic"
WEB_WRAPPER="/usr/local/bin/kms_mosaic_web"
KMS_LIBDIR="/usr/local/lib/kms_mosaic"
SNAPSHOT_REQUEST="/tmp/kms_mosaic_snapshot.request"
SNAPSHOT_OUTPUT="/tmp/kms_mosaic_preview.rgba"

logging_enabled() {
  case "${LOG_ENABLE:-disable}" in
    enable|enabled|1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

kms_log_target() {
  if logging_enabled; then
    : > "$KMS_LOG" 2>/dev/null || true
    printf '%s' "$KMS_LOG"
  else
    rm -f "$KMS_LOG" 2>/dev/null || true
    printf '%s' "/dev/null"
  fi
}

web_log_target() {
  if logging_enabled; then
    : > "$WEB_LOG" 2>/dev/null || true
    printf '%s' "$WEB_LOG"
  else
    rm -f "$WEB_LOG" 2>/dev/null || true
    printf '%s' "/dev/null"
  fi
}

kms_extra_args() {
  local args="${KMS_ARGS:-}"
  if logging_enabled; then
    args="${args:+${args} }--debug"
  fi
  printf '%s' "$args"
  return 0
}

web_extra_args() {
  if logging_enabled; then
    printf '%s' "--verbose"
  fi
  return 0
}

cleanup_host_gpu_libs() {
  rm -f "$KMS_LIBDIR"/libdrm*.so* \
        "$KMS_LIBDIR"/libgbm.so* \
        "$KMS_LIBDIR"/libEGL*.so* \
        "$KMS_LIBDIR"/libGLESv2.so* \
        "$KMS_LIBDIR"/libGL*.so* \
        "$KMS_LIBDIR"/libOpenGL.so* \
        "$KMS_LIBDIR"/libgallium*.so* \
        "$KMS_LIBDIR"/libX11*.so* \
        "$KMS_LIBDIR"/libXau.so* \
        "$KMS_LIBDIR"/libXdmcp.so* \
        "$KMS_LIBDIR"/libXext.so* \
        "$KMS_LIBDIR"/libxcb*.so* \
        "$KMS_LIBDIR"/libwayland*.so* \
        "$KMS_LIBDIR"/libxshmfence.so* \
        "$KMS_LIBDIR"/libpciaccess.so* \
        "$KMS_LIBDIR"/libLLVM*.so* \
        "$KMS_LIBDIR"/libSPIRV*.so* \
        "$KMS_LIBDIR"/libsensors.so* \
        "$KMS_LIBDIR"/libelf.so* \
        "$KMS_LIBDIR"/libedit.so* \
        "$KMS_LIBDIR"/libexpat.so* \
        "$KMS_LIBDIR"/libz.so* \
        "$KMS_LIBDIR"/libzstd.so* \
        "$KMS_LIBDIR"/liblzma.so* \
        "$KMS_LIBDIR"/libbz2.so* \
        "$KMS_LIBDIR"/libffi.so* \
        "$KMS_LIBDIR"/libncursesw.so* \
        "$KMS_LIBDIR"/libtinfo.so* 2>/dev/null || true
}

wait_for_runtime_dependencies() {
  local waited=0
  while [ "$waited" -lt "$STARTUP_DEP_TIMEOUT" ]; do
    if compgen -G '/dev/dri/card*' >/dev/null &&
       [ -r /usr/lib64/libdrm.so.2 ] &&
       [ -r /usr/lib64/libgbm.so.1 ] &&
       [ -r /usr/lib64/libEGL.so.1 ] &&
       [ -r /usr/lib64/libGLESv2.so.2 ] &&
       [ -d /usr/lib64/dri ]; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

request_fresh_render() {
  local waited=0
  rm -f "$SNAPSHOT_OUTPUT" 2>/dev/null || true
  touch "$SNAPSHOT_REQUEST"
  while [ "$waited" -lt "$STARTUP_HEALTH_TIMEOUT" ]; do
    is_kms_running || return 1
    if [ -s "$SNAPSHOT_OUTPUT" ]; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

kms_render_healthy() {
  request_fresh_render || return 1
  sleep 2
  request_fresh_render || return 1
  rm -f "$SNAPSHOT_REQUEST" "$SNAPSHOT_OUTPUT" 2>/dev/null || true
  return 0
}

launch_detached() {
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid "$@" &
  else
    nohup "$@" &
  fi
}

web_pid_from_system() {
  pgrep -fo "/usr/local/bin/kms_mosaic_web.py --config ${CONFIG_PATH} --host ${WEB_HOST} --port ${WEB_PORT}" 2>/dev/null || true
}

is_kms_running() {
  pgrep -x kms_mosaic.bin >/dev/null 2>&1
}

kms_pid_from_system() {
  pgrep -x kms_mosaic.bin | head -n1 2>/dev/null || true
}

kms_pids_from_system() {
  pgrep -x kms_mosaic.bin 2>/dev/null || true
}

wait_for_kms_exit() {
  local max_wait="${1:-20}"
  local waited=0
  while [ "$waited" -lt "$max_wait" ]; do
    if ! is_kms_running; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

kms_child_group_leaders() {
  local pid="$1"
  [ -n "$pid" ] || return 0
  ps -o pid=,pgid= --ppid "$pid" 2>/dev/null | awk '
    NF >= 2 {
      pid = $1
      pgid = $2
      if (pgid == "" || pgid == "0") pgid = pid
      if (!seen[pgid]++) print pgid
    }
  '
}

kill_process_group() {
  local leader="$1"
  [ -n "$leader" ] || return 0
  kill -- "-${leader}" 2>/dev/null || true
  kill "$leader" 2>/dev/null || true
  sleep 1
  kill -9 -- "-${leader}" 2>/dev/null || true
  kill -9 "$leader" 2>/dev/null || true
}

is_web_running() {
  local pid=""
  if [ -f "$WEB_PIDFILE" ]; then
    pid="$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
  fi
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  pid="$(web_pid_from_system)"
  [ -n "$pid" ] || return 1
  write_pidfile "$WEB_PIDFILE" "$pid"
  kill -0 "$pid" 2>/dev/null
}

write_pidfile() {
  local file="$1"
  local pid="$2"
  printf '%s\n' "$pid" > "$file"
}

cleanup_pidfile() {
  local file="$1"
  rm -f "$file" 2>/dev/null || true
}

post_start_ddc() {
(
  sleep 5
  python3 - <<'PY'
import fcntl
import os
import time

I2C_SLAVE_FORCE = 0x0706
BUS = "/dev/i2c-3"
ADDR = 0x37

def checksum(payload):
    value = 0x6E
    for byte in payload:
        value ^= byte
    return value

def send(payload):
    message = bytes(payload + [checksum(payload)])
    fd = os.open(BUS, os.O_RDWR)
    try:
        fcntl.ioctl(fd, I2C_SLAVE_FORCE, ADDR)
        os.write(fd, message)
    finally:
        os.close(fd)

for payload in (
    [0x51, 0x84, 0x03, 0x14, 0x00, 0x06],
    [0x51, 0x84, 0x03, 0x10, 0x00, 0x64],
    [0x51, 0x84, 0x03, 0x12, 0x00, 0x64],
    [0x51, 0x81, 0x0C],
):
    send(payload)
    time.sleep(0.2)
PY
) >/dev/null 2>&1 &
}

start_kms() {
  [ "${SERVICE}" = "enable" ] || return 0
  is_kms_running && return 0
  if ! wait_for_runtime_dependencies; then
    return 1
  fi
  local attempt
  for attempt in 1 2; do
    cleanup_host_gpu_libs
    local target
    target="$(kms_log_target)"
    local extra
    extra="$(kms_extra_args)"
    if [ -n "$extra" ]; then
      launch_detached "$KMS_WRAPPER" --config "$CONFIG_PATH" $extra >"$target" 2>&1
    else
      launch_detached "$KMS_WRAPPER" --config "$CONFIG_PATH" >"$target" 2>&1
    fi
    write_pidfile "$KMS_PIDFILE" "$!"
    sleep 3
    if is_kms_running && kms_render_healthy; then
      post_start_ddc
      return 0
    fi
    stop_kms
    cleanup_pidfile "$KMS_PIDFILE"
    sleep 5
  done
}

stop_kms() {
  local pids=""
  local pid=""
  local child_groups=""
  pids="$(kms_pids_from_system)"
  if [ -n "$pids" ]; then
    for pid in $pids; do
      local new_groups=""
      new_groups="$(kms_child_group_leaders "$pid" || true)"
      if [ -n "$new_groups" ]; then
        child_groups="$(printf '%s\n%s\n' "$child_groups" "$new_groups" | awk 'NF && !seen[$0]++')"
      fi
      kill "$pid" 2>/dev/null || true
    done
    for _ in 1 2 3 4 5; do
      local any_running="false"
      for pid in $pids; do
        local new_groups=""
        new_groups="$(kms_child_group_leaders "$pid" || true)"
        if [ -n "$new_groups" ]; then
          child_groups="$(printf '%s\n%s\n' "$child_groups" "$new_groups" | awk 'NF && !seen[$0]++')"
        fi
        if kill -0 "$pid" 2>/dev/null; then
          any_running="true"
        fi
      done
      if [ "$any_running" = "false" ]; then
        break
      fi
      sleep 1
    done
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    done
    wait_for_kms_exit 20 || true
    for leader in $child_groups; do
      kill_process_group "$leader"
    done
  fi
  cleanup_pidfile "$KMS_PIDFILE"
}

start_web() {
  [ "${WEB_SERVICE}" = "enable" ] || return 0
  is_web_running && return 0
  local target
  target="$(web_log_target)"
  local extra
  extra="$(web_extra_args)"
  if [ -n "$extra" ]; then
    launch_detached "$WEB_WRAPPER" --config "$CONFIG_PATH" --host "$WEB_HOST" --port "$WEB_PORT" $extra >"$target" 2>&1
  else
    launch_detached "$WEB_WRAPPER" --config "$CONFIG_PATH" --host "$WEB_HOST" --port "$WEB_PORT" >"$target" 2>&1
  fi
  sleep 1
  local pid="$!"
  if ! kill -0 "$pid" 2>/dev/null; then
    pid="$(web_pid_from_system)"
  fi
  [ -n "$pid" ] && write_pidfile "$WEB_PIDFILE" "$pid"
}

stop_web() {
  local pid=""
  if is_web_running; then
    pid="$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    sleep 2
  fi
  pid="$(web_pid_from_system)"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  cleanup_pidfile "$WEB_PIDFILE"
}

status_json() {
  local kms_pid=""
  local web_pid=""
  local kms_running="false"
  local web_running="false"
  if is_kms_running; then
    kms_pid="$(pgrep -x kms_mosaic.bin | head -n1)"
    kms_running="true"
  fi
  if is_web_running; then
    web_pid="$(cat "$WEB_PIDFILE" 2>/dev/null || true)"
    web_running="true"
  fi
  cat <<EOF
{"service":"${SERVICE}","web_service":"${WEB_SERVICE}","web_port":"${WEB_PORT}","config_path":"${CONFIG_PATH}","log_enable":"${LOG_ENABLE}","kms_args":"${KMS_ARGS}","kms_running":${kms_running},"web_running":${web_running},"kms_pid":"${kms_pid}","web_pid":"${web_pid}"}
EOF
}

cmd="${1:-status}"
case "$cmd" in
  start)
    start_kms
    start_web
    ;;
  stop)
    stop_web
    stop_kms
    ;;
  restart)
    stop_web
    stop_kms
    wait_for_kms_exit 20 || true
    start_kms
    start_web
    ;;
  status)
    status_json
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
