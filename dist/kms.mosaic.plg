<?xml version="1.0" standalone="yes"?>
<PLUGIN
  name="kms.mosaic"
  author="OpenAI / chronostriker1"
  version="2026.08.11"
  launch="Settings/KMSMosaic"
  pluginURL="https://raw.githubusercontent.com/chronostriker1/KMS_Mosaic/main/unraid-plugin/kms.mosaic.plg"
  icon="desktop"
  description="Direct-rendered DRM video wall and terminal compositor with pane layout editing, mpv-backed media panes, and live preview management from Unraid.">

<CHANGES>
###2026.08.11
- Let Unraid finish booting when the array is stopped and configured media paths are unavailable.
- Restart the preview service onto the WebRTC-capable Python venv when `/mnt/cache` becomes available after boot.
- Raise Quality preview capture to a 1080-pixel edge and enforce an 8-12 Mbps H.264 encoder range.
- Keep Balanced and Economy preview profiles available for lower-bandwidth clients.

###2026.07.23.2
- Replace in-process config re-execs with fresh supervisor-managed processes.
- Detect a live compositor that stops rendering and restart it automatically.
- Keep frame monitoring and pane cleanup active while the supervisor waits on the compositor.

###2026.07.23
- Supervise and automatically restart the compositor and preview service after unexpected exits.
- Preserve bounded application tails and persistent lifecycle/exit-status records even when verbose logging is disabled.
- Allow slower shader-heavy layouts 30 seconds to produce startup health frames.
- Route every embedded plugin API request through the authenticated Unraid proxy, including scenes, templates, history, monitor controls, and WebRTC keepalives.

###2026.07.10
- Use DRM page-flip events instead of reprogramming the CRTC for every frame, fixing stalls after Unraid 7.3.2.
- Fix nonblocking atomic presentation so completion events release in-flight buffers correctly.
- Make nonblocking atomic presentation the plugin default for current Unraid kernels.
- Wait for Unraid's host graphics stack and verify two fresh rendered frames before declaring startup healthy.
- Launch compositor and web services in isolated sessions for reliable restart cleanup.

###2026.05.01
- Fix mpv panes after Unraid 7.2.5 by no longer bundling/shadowing host GLVND/Mesa libraries.
- Remove stale packaged GL libraries during install so the compositor uses Unraid's current GPU stack.

###2026.04.17
- Quiet default logging: no log files created unless `LOG_ENABLE="enable"` set in plugin cfg.
- Web UI + compositor discard stdout/stderr by default to stop `/tmp/*.log` growth.

###2026.03.19
- Fix package version drift so plugin installs deploy the current runtime binary.
- Restore `panscan` editing in the selected mpv pane editor.

###2026.03.18
- Add native Unraid plugin packaging for KMS Mosaic.
- Manage `kms_mosaic` and the web UI without the old userscript.
- Host the full configuration UI directly inside the Unraid Settings page.
</CHANGES>

<FILE Name="/boot/config/plugins/kms.mosaic/kms.mosaic-2026.08.11.tgz">
<URL>https://raw.githubusercontent.com/chronostriker1/KMS_Mosaic/main/dist/kms.mosaic-2026.08.11.tgz</URL>
</FILE>

<FILE Name="/boot/config/plugins/kms.mosaic/kms_mosaic-2026.08.11-x86_64-1.txz">
<URL>https://raw.githubusercontent.com/chronostriker1/KMS_Mosaic/main/dist/kms_mosaic-2026.08.11-x86_64-1.txz</URL>
</FILE>

<FILE Name="/boot/config/plugins/kms.mosaic/kms.mosaic.cfg">
<INLINE>
<![CDATA[
SERVICE="enable"
WEB_SERVICE="enable"
WEB_PORT="8788"
CONFIG_PATH="/boot/config/kms_mosaic.conf"
LOG_ENABLE="disable"
KMS_ARGS="--atomic-nonblock"
DDC_STARTUP="enable"
DDC_CONNECTOR=""
DDC_BUS=""
DDC_INPUT_CODE="20"
DDC_INPUT_VALUE="6"
DDC_BRIGHTNESS="100"
DDC_CONTRAST="100"
DDC_SAVE="enable"
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
mkdir -p /usr/local/emhttp/plugins/kms.mosaic
# Older broken plugin bundles could leave duplicate page trees under /usr/local/emhttp/plugins.
# Those stale copies can override the live Settings route even after a correct reinstall.
rm -rf /usr/local/emhttp/plugins/usr
rm -rf /usr/local/emhttp/plugins/kms.mosaic.backup
# Remove any older versioned artifacts from prior installs so only the current version remains.
find /boot/config/plugins/kms.mosaic -maxdepth 1 -type f \( -name 'kms.mosaic-*.tgz' -o -name 'kms_mosaic-*-x86_64-1.txz' \) ! -name 'kms.mosaic-2026.08.11.tgz' ! -name 'kms_mosaic-2026.08.11-x86_64-1.txz' -delete 2>/dev/null || true
tar --no-overwrite-dir --no-same-owner -xzf /boot/config/plugins/kms.mosaic/kms.mosaic-2026.08.11.tgz -C /
chown root:root /usr/local /usr/local/bin /usr/local/emhttp /usr/local/emhttp/plugins
chown -R root:root /usr/local/emhttp/plugins/kms.mosaic
chown root:root /usr/local/bin/kms_mosaic_web /usr/local/bin/kms_mosaic_web.py
find /usr/local/emhttp/plugins/kms.mosaic -type d -exec chmod 0755 {} +
find /usr/local/emhttp/plugins/kms.mosaic -type f -exec chmod 0644 {} +
upgradepkg --install-new --reinstall /boot/config/plugins/kms.mosaic/kms_mosaic-2026.08.11-x86_64-1.txz
rm -f /usr/local/lib/kms_mosaic/libdrm*.so* \
      /usr/local/lib/kms_mosaic/libgbm.so* \
      /usr/local/lib/kms_mosaic/libEGL*.so* \
      /usr/local/lib/kms_mosaic/libGLESv2.so* \
      /usr/local/lib/kms_mosaic/libGL*.so* \
      /usr/local/lib/kms_mosaic/libOpenGL.so* \
      /usr/local/lib/kms_mosaic/libgallium*.so* \
      /usr/local/lib/kms_mosaic/libX11*.so* \
      /usr/local/lib/kms_mosaic/libXau.so* \
      /usr/local/lib/kms_mosaic/libXdmcp.so* \
      /usr/local/lib/kms_mosaic/libXext.so* \
      /usr/local/lib/kms_mosaic/libxcb*.so* \
      /usr/local/lib/kms_mosaic/libwayland*.so* \
      /usr/local/lib/kms_mosaic/libxshmfence.so* \
      /usr/local/lib/kms_mosaic/libpciaccess.so* \
      /usr/local/lib/kms_mosaic/libLLVM*.so* \
      /usr/local/lib/kms_mosaic/libSPIRV*.so* \
      /usr/local/lib/kms_mosaic/libsensors.so* \
      /usr/local/lib/kms_mosaic/libelf.so* \
      /usr/local/lib/kms_mosaic/libedit.so* \
      /usr/local/lib/kms_mosaic/libexpat.so* \
      /usr/local/lib/kms_mosaic/libz.so* \
      /usr/local/lib/kms_mosaic/libzstd.so* \
      /usr/local/lib/kms_mosaic/liblzma.so* \
      /usr/local/lib/kms_mosaic/libbz2.so* \
      /usr/local/lib/kms_mosaic/libffi.so* \
      /usr/local/lib/kms_mosaic/libncursesw.so* \
      /usr/local/lib/kms_mosaic/libtinfo.so* 2>/dev/null || true
chmod +x /usr/local/bin/kms_mosaic_web
chmod +x /usr/local/bin/kms_mosaic_web.py
chmod +x /usr/local/emhttp/plugins/kms.mosaic/event/started
chmod +x /usr/local/emhttp/plugins/kms.mosaic/event/stopping_svcs
chmod +x /usr/local/emhttp/plugins/kms.mosaic/scripts/kms_mosaic-service
legacy_userscript="/boot/config/plugins/user.scripts/scripts/Start kms_mosaic"
legacy_backup="/boot/config/plugins/user.scripts/scripts/Start kms_mosaic.disabled-by-kms-mosaic-plugin"
if [ -d "$legacy_userscript" ] && [ ! -e "$legacy_backup" ]; then
  mv "$legacy_userscript" "$legacy_backup"
fi
# Drop any previously-created noisy log files so fresh install starts clean.
rm -f /tmp/start_kms_mosaic.log /tmp/kms_mosaic_web.log 2>/dev/null || true
/usr/local/emhttp/plugins/kms.mosaic/scripts/kms_mosaic-service restart >/dev/null 2>&1 || true
echo ""
echo "-----------------------------------------------------------"
echo " Plugin kms.mosaic is installed."
echo " Version: 2026.08.11"
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
/usr/local/emhttp/plugins/kms.mosaic/scripts/kms_mosaic-service stop >/dev/null 2>&1 || true
rm -rf /usr/local/emhttp/plugins/kms.mosaic
rm -f /usr/local/bin/kms_mosaic_web /usr/local/bin/kms_mosaic_web.py
legacy_userscript="/boot/config/plugins/user.scripts/scripts/Start kms_mosaic"
legacy_backup="/boot/config/plugins/user.scripts/scripts/Start kms_mosaic.disabled-by-kms-mosaic-plugin"
if [ -d "$legacy_backup" ] && [ ! -e "$legacy_userscript" ]; then
  mv "$legacy_backup" "$legacy_userscript"
fi
rm -rf /boot/config/plugins/kms.mosaic
echo ""
echo "-----------------------------------------------------------"
echo " Plugin kms.mosaic is removed."
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
